      <div class="floating-badge badge-1">Computer Science</div>
      <div class="floating-badge badge-2">Cyber Security</div>
      <div class="floating-badge badge-3">Bina Nusantara</div>
      <div class="floating-badge badge-4">Semester 5</div>
    </div>
    <div class="scroll-indicator"><span>Scroll</span><i data-feather="arrow-down"></i></div>
