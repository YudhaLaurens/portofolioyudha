  <section class="section" id="certifications">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">05. Certifications</span>
      </div>
      <div class="certifications-grid">
        <article class="cert-card">
          <img src="assets/cert_bncc.jpg" alt="Certificate of Completion BNCC" class="cert-image" loading="lazy" />
          <div class="cert-info">
            <h3 class="cert-title">Front-End Development</h3>
            <p class="cert-issuer">BNCC - BINUS University</p>
            <span class="cert-date">Class of 2024/2025 • Achievement of Distinction</span>
          </div>
        </article>
      </div>
