  <section class="hero" id="hero">
    <div class="hero-content">
      <p class="hero-greeting">Hi, I'm</p>
      <h1 class="hero-name">Yudha Dwi Anantha Laurens</h1>
      <h2 class="hero-title"><span id="typed"></span><span class="cursor">|</span></h2>
      <p class="hero-desc">Mahasiswa Computer Science di Universitas Bina Nusantara.</p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">Lihat Proyek</a>
        <a href="#contact" class="btn btn-outline">Hubungi Saya</a>
      </div>
      <div class="hero-socials">
        <a href="https://github.com/YudhaLaurens" target="_blank"><i data-feather="github"></i></a>
        <a href="https://www.linkedin.com/in/yudha-laurens/" target="_blank"><i data-feather="linkedin"></i></a>
        <a href="mailto:yudhaanantha@gmail.com"><i data-feather="mail"></i></a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="avatar-ring">
        <div class="avatar-placeholder">
          <img src="assets/profile.jpg" alt="Foto profil" />
        </div>
