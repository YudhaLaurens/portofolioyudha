  <section class="section section-alt" id="contact">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">06. Contact</span>
      </div>
      <div class="contact-grid">
        <div class="contact-info">
          <p class="contact-intro">Tertarik untuk berkolaborasi, berdiskusi tentang proyek, atau ada kesempatan yang ingin Anda tawarkan? Jangan ragu untuk menghubungi saya!</p>
          <div class="contact-details">
            <a href="mailto:yudhaanantha@gmail.com" class="contact-item"><i data-feather="mail"></i><span>yudhaanantha@gmail.com</span></a>
            <a href="https://www.linkedin.com/in/yudha-laurens/" target="_blank" class="contact-item"><i data-feather="linkedin"></i><span>linkedin.com/in/yudha-laurens</span></a>
            <a href="https://github.com/yudha-laurens" target="_blank" class="contact-item"><i data-feather="github"></i><span>github.com/yudha-laurens</span></a>
            <div class="contact-item"><i data-feather="map-pin"></i><span>Jakarta, Indonesia</span></div>
          </div>
        </div>
        <form class="contact-form" id="contact-form">
          <div class="form-group"><label for="name">Nama</label><input type="text" id="name" placeholder="Nama lengkap Anda" required /></div>
          <div class="form-group"><label for="email">Email</label><input type="email" id="email" placeholder="email@contoh.com" required /></div>
          <div class="form-group"><label for="subject">Subjek</label><input type="text" id="subject" placeholder="Tentang apa?" required /></div>
          <div class="form-group"><label for="message">Pesan</label><textarea id="message" rows="5" placeholder="Tulis pesan Anda di sini..." required></textarea></div>
          <button type="submit" class="btn btn-primary btn-full"><i data-feather="send"></i> Kirim Pesan</button>
          <p class="form-note" id="form-status"></p>
        </form>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <p>Dibuat oleh <strong>Yudha</strong></p>
      <p class="footer-sub">© 2026 — All rights reserved</p>
    </div>
