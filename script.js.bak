// ===== FEATHER ICONS =====
document.addEventListener('DOMContentLoaded', () => {
  feather.replace();
});

// ===== TYPED EFFECT =====
const typedEl = document.getElementById('typed');
const roles = [
  'Computer Science Student',
  'Cyber Security Student',
  'Tech Enthusiast'
];
let roleIdx = 0, charIdx = 0, isDeleting = false;

function type() {
  const current = roles[roleIdx];
  typedEl.textContent = isDeleting
    ? current.substring(0, charIdx--)
    : current.substring(0, charIdx++);

  let speed = isDeleting ? 60 : 100;
  if (!isDeleting && charIdx === current.length + 1) {
    speed = 1800; isDeleting = true;
  } else if (isDeleting && charIdx === 0) {
    isDeleting = false;
    roleIdx = (roleIdx + 1) % roles.length;
    speed = 400;
  }
  setTimeout(type, speed);
}
type();

// ===== THEME TOGGLE =====
const body = document.body;
const themeToggle = document.getElementById('theme-toggle');

function updateThemeButton() {
  const darkMode = body.classList.contains('dark-theme');
  const icon = darkMode ? 'sun' : 'moon';
  themeToggle.innerHTML = '<i data-feather="' + icon + '"></i>';
  feather.replace();
}

const savedTheme = localStorage.getItem('theme');
const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
  body.classList.add('dark-theme');
}
updateThemeButton();

themeToggle.addEventListener('click', () => {
  body.classList.toggle('dark-theme');
  const isDark = body.classList.contains('dark-theme');
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
  updateThemeButton();
});

// ===== NAVBAR SCROLL =====
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 20);
});

// ===== HAMBURGER MENU =====
const hamburger = document.getElementById('hamburger');
const navLinks = document.getElementById('nav-links');
hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
navLinks.querySelectorAll('a').forEach(a =>
  a.addEventListener('click', () => navLinks.classList.remove('open'))
);

// ===== ACTIVE NAV LINK ON SCROLL =====
const sections = document.querySelectorAll('section[id]');
const navItems = document.querySelectorAll('.nav-links a');
window.addEventListener('scroll', () => {
  let current = '';
  sections.forEach(s => {
    if (window.scrollY >= s.offsetTop - 120) current = s.id;
  });
  navItems.forEach(a => {
    a.style.color = a.getAttribute('href') === '#' + current
      ? 'var(--accent)' : '';
  });
});

// ===== SCROLL PROGRESS BAR =====
const progressBar = document.createElement('div');
progressBar.className = 'scroll-progress-bar';
document.body.prepend(progressBar);
window.addEventListener('scroll', () => {
  const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight);
  progressBar.style.width = (scrolled * 100) + '%';
});

// ===== REVEAL ON SCROLL (multi-direction) =====
function setupReveal() {
  // Section headers — slide up
  document.querySelectorAll('.section-header').forEach((el, i) => {
    el.classList.add('reveal', 'reveal-up');
  });
  // About text — dari kiri, stats — dari kanan
  document.querySelectorAll('.about-text').forEach(el => el.classList.add('reveal', 'reveal-left'));
  document.querySelectorAll('.about-stats').forEach(el => el.classList.add('reveal', 'reveal-right'));
  // Stat cards — stagger scale
  document.querySelectorAll('.stat-card').forEach((el, i) => {
    el.classList.add('reveal', 'reveal-scale', `delay-${i + 1}`);
  });
  // Skills — stagger dari kiri/kanan selang-seling
  document.querySelectorAll('.skill-category').forEach((el, i) => {
    el.classList.add('reveal', i % 2 === 0 ? 'reveal-left' : 'reveal-right', `delay-${(i % 3) + 1}`);
  });
  // Project cards — stagger up
  document.querySelectorAll('.project-card').forEach((el, i) => {
    el.classList.add('reveal', 'reveal-up', `delay-${(i % 3) + 1}`);
  });
  // Timeline items — dari kiri
  document.querySelectorAll('.timeline-item').forEach((el, i) => {
    el.classList.add('reveal', 'reveal-left', `delay-${(i % 3) + 1}`);
  });
  // Certifications — dari bawah
  document.querySelectorAll('.cert-card').forEach((el, i) => {
    el.classList.add('reveal', 'reveal-up', `delay-${(i % 3) + 1}`);
  });
  // Contact grid
  document.querySelectorAll('.contact-grid').forEach(el => el.classList.add('reveal', 'reveal-up'));
}
setupReveal();

const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.12 });

document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

// ===== SKILL TAGS BOUNCE IN =====
const skillTagObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const tags = entry.target.querySelectorAll('.skill-tag');
      tags.forEach((tag, i) => {
        setTimeout(() => tag.classList.add('visible'), i * 80);
      });
      skillTagObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.3 });

document.querySelectorAll('.skill-category, .project-tags').forEach(el => skillTagObserver.observe(el));

// ===== 3D TILT + SHIMMER (reusable untuk semua card) =====
function applyTilt(selector, intensity = 8) {
  document.querySelectorAll(selector).forEach(card => {
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const rotX = ((y - cy) / cy) * -intensity;
      const rotY = ((x - cx) / cx) * intensity;

      card.style.transform = `perspective(700px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-5px)`;
      card.style.setProperty('--mx', ((x / rect.width) * 100).toFixed(1) + '%');
      card.style.setProperty('--my', ((y / rect.height) * 100).toFixed(1) + '%');
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.setProperty('--mx', '50%');
      card.style.setProperty('--my', '50%');
    });
  });
}

applyTilt('.project-card', 8);
applyTilt('.stat-card', 6);
applyTilt('.skill-category', 6);
applyTilt('.timeline-content', 5);
applyTilt('.contact-form', 4);
applyTilt('.cert-card', 6);

// ===== COUNTER ANIMATION =====
function animateCounters() {
  document.querySelectorAll('.stat-number').forEach(el => {
    const target = el.textContent.replace(/[^0-9]/g, '');
    const suffix = el.textContent.replace(/[0-9]/g, '');
    if (!target) return;
    let count = 0;
    const end = parseInt(target);
    const step = Math.ceil(end / 40);
    const timer = setInterval(() => {
      count = Math.min(count + step, end);
      el.textContent = count + suffix;
      if (count >= end) clearInterval(timer);
    }, 40);
  });
}

const statsSection = document.querySelector('.about-stats');
if (statsSection) {
  const statsObserver = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      animateCounters();
      statsObserver.disconnect();
    }
  }, { threshold: 0.5 });
  statsObserver.observe(statsSection);
}

// ===== CONTACT FORM =====
const form = document.getElementById('contact-form');
const status = document.getElementById('form-status');

form.addEventListener('submit', e => {
  e.preventDefault();
  const btn = form.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.innerHTML = 'Mengirim...';

  // Simulasi kirim (ganti dengan EmailJS / Formspree / backend lo sendiri)
  setTimeout(() => {
    status.textContent = 'Pesan berhasil dikirim! Saya akan segera membalas.';
    status.className = 'form-note success';
    form.reset();
    btn.disabled = false;
    btn.innerHTML = '<i data-feather="send"></i> Kirim Pesan';
    feather.replace();
    setTimeout(() => {
      status.textContent = '';
      status.className = 'form-note';
    }, 5000);
  }, 1500);
});

// ===== Project card hover is handled via CSS to avoid animation conflicts =====

// ===== TIMELINE SCROLL ANIMATION =====
const timelineProgress = document.getElementById('timeline-progress');
const timelineEl = document.querySelector('.timeline');
const timelineDots = document.querySelectorAll('.timeline-dot');
const timelineItems = document.querySelectorAll('.timeline-item');

function updateTimeline() {
  if (!timelineEl || !timelineProgress) return;

  const timelineRect = timelineEl.getBoundingClientRect();
  const timelineTop = timelineEl.offsetTop;
  const timelineHeight = timelineEl.offsetHeight;
  const scrollY = window.scrollY;
  const windowMid = scrollY + window.innerHeight * 0.6;

  // Hitung progress garis (0% - 100%)
  const progress = Math.min(
    Math.max((windowMid - timelineTop) / timelineHeight, 0),
    1
  );
  timelineProgress.style.height = (progress * 100) + '%';

  // Aktifkan dots satu per satu
  timelineItems.forEach((item, i) => {
    const dot = item.querySelector('.timeline-dot');
    const itemMid = item.offsetTop + item.offsetHeight / 2;
    if (windowMid >= timelineTop + itemMid) {
      dot.classList.add('active');
    } else {
      dot.classList.remove('active');
    }
  });
}

window.addEventListener('scroll', updateTimeline);
window.addEventListener('load', updateTimeline);
